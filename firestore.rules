rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ghanaforexfintechcryptoexpo@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Vehicles Catalog Rules
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(vehicleId);
    }

    // Sourcing Requests Rules
    match /sourcingRequests/{requestId} {
      allow create: if isValidId(requestId) &&
                    request.resource.data.fullName is string &&
                    request.resource.data.fullName.size() <= 128 &&
                    request.resource.data.phone is string &&
                    request.resource.data.phone.size() <= 32;
      allow read, update, delete: if isAdmin();
    }

    // Enquiries Rules
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId) &&
                    request.resource.data.fullName is string &&
                    request.resource.data.fullName.size() <= 128 &&
                    request.resource.data.phone is string &&
                    request.resource.data.phone.size() <= 32;
      allow read, update, delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}
